{
  "name": "orvok-social",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:provision:local": "tsx scripts/provision-runtime-roles.ts --local",
    "db:provision:reapply": "tsx scripts/provision-runtime-roles.ts --reapply-local",
    "auth:mail-worker": "tsx scripts/auth-mail-worker.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "test:desafio": "tsx scripts/test-desafio.ts",
    "test:mundo": "tsx scripts/test-mundo.ts",
    "test:dados": "tsx scripts/test-dados.ts",
    "test:estante": "tsx scripts/test-estante.ts",
    "test:moderacao": "tsx scripts/test-moderacao.ts",
    "test:svg": "tsx scripts/test-svg.ts",
    "simulacao": "tsx scripts/simulacao/principal.ts",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:cartao": "tsx scripts/test-cartao.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "dotenv": "17.4.2",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
