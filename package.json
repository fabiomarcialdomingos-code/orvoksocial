{
  "name": "orvok-social",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.18.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:verify:consent-migrations": "tsx scripts/verify-consent-migrations.ts",
    "db:verify:clean-database": "tsx scripts/verify-clean-database.ts",
    "db:verify:incremental-database": "tsx scripts/verify-incremental-database.ts",
    "db:verify:backup-restore": "tsx scripts/verify-backup-restore.ts",
    "db:verify:runtime-boundary": "tsx scripts/verify-runtime-boundary.ts",
    "db:verify:read-boundary": "tsx scripts/verify-read-boundary.ts",
    "db:verify:radar-rpc": "tsx scripts/verify-radar-rpc-flow.ts",
    "db:verify:radar-concurrency": "tsx scripts/verify-radar-concurrency.ts",
    "db:verify:radar-hardening": "tsx scripts/verify-radar-hardening.ts",
    "radar:metrics": "tsx scripts/radar-metrics.ts",
    "math:worker": "tsx scripts/math-engine-worker.ts",
    "db:verify:math-persistence": "tsx scripts/verify-math-persistence.ts",
    "db:verify:math-orchestration": "tsx scripts/verify-math-orchestration.ts",
    "db:provision:local": "tsx scripts/provision-runtime-roles.ts --local",
    "db:provision:reapply": "tsx scripts/provision-runtime-roles.ts --reapply-local",
    "auth:mail-worker": "tsx scripts/auth-mail-worker.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "next": "16.3.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
