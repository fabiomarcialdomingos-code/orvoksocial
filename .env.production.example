# Owner URL belongs only to the migration/DBA process, never the web runtime.
APP_DATABASE_URL="postgresql://orvok_app_runtime:replace_me@production-db.example.invalid:5432/orvok_production?sslmode=require"
AUTH_DATABASE_URL="postgresql://orvok_auth_runtime:replace_me@production-db.example.invalid:5432/orvok_production?sslmode=require"
APP_ENV="production"
APP_ORIGIN="https://orvok.example.invalid"
AUTH_SECRET="replace_with_at_least_32_random_characters"
AUTH_MAIL_KEY="replace_with_64_hexadecimal_characters"
# Opcional: libera o diagnóstico detalhado de /api/ready (nomes de tabela, estado de
# migração/grants) para quem enviar este valor no header X-Readiness-Key. Sem ela,
# o endpoint só responde ready/not_ready, sem detalhe, em produção/staging.
READINESS_CHECK_KEY="replace_with_a_long_random_value"
SMTP_HOST="smtp.example.invalid"
SMTP_PORT="587"
SMTP_FROM="noreply@orvok.example.invalid"
SMTP_USER="replace_me"
SMTP_PASS="replace_me"
MATH_ENGINE_ENABLED="false"
SCORE_PUBLICATION_ENABLED="false"
RADAR_SCORE_PUBLICATION_ENABLED="false"
RANKING_ENABLED="false"
MATHEMATICAL_REPUTATION_ENABLED="false"
OFFICIAL_RADAR_CATALOG_ENABLED="false"
REAL_USER_HOMOLOGATION_ENABLED="false"
