# Local development only. Copy to .env and replace placeholders.
DATABASE_URL="postgresql://orvok_local:replace_me@127.0.0.1:55432/orvok_dev?schema=public"
APP_ENV="development"
APP_ORIGIN="http://localhost:3000"
AUTH_SECRET="replace_with_at_least_32_random_characters"
AUTH_MAIL_KEY="replace_with_64_hexadecimal_characters"
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="noreply@orvok.test"
# Avisos push (opcional). Sem isso, o app funciona normal, só sem avisos
# quando fechado. Gere um par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT_EMAIL="mailto:contato@orvok.com.br"
