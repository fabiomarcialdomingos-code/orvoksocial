# Local development only. Copy to .env and replace placeholders.
DATABASE_URL="postgresql://orvok_local:replace_me@127.0.0.1:55432/orvok_dev?schema=public"
APP_ENV="development"
APP_ORIGIN="http://localhost:3000"
AUTH_SECRET="replace_with_at_least_32_random_characters"
AUTH_MAIL_KEY="replace_with_64_hexadecimal_characters"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_FROM="noreply@orvok.test"
# Mathematical engine gates. Keep publication and real-user gates closed until
# formal product, legal, and infrastructure approvals are recorded.
MATH_ENGINE_ENABLED="false"
SCORE_PUBLICATION_ENABLED="false"
RADAR_SCORE_PUBLICATION_ENABLED="false"
RANKING_ENABLED="false"
MATHEMATICAL_REPUTATION_ENABLED="false"
OFFICIAL_RADAR_CATALOG_ENABLED="false"
REAL_USER_HOMOLOGATION_ENABLED="false"
